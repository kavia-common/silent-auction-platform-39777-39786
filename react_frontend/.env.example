# Copy this file to .env and fill in your Supabase project details.
# Do not commit secrets to version control.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
REACT_APP_SUPABASE_URL=

# Supabase anon public key (Settings > API > Project API keys)
REACT_APP_SUPABASE_KEY=

# Optional: Site URL used for auth redirects (defaults to window.location.origin at runtime)
# REACT_APP_SITE_URL=
