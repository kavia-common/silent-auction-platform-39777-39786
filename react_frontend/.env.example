# Copy this file to `.env` in the same directory and fill in your Supabase project details.
# These variables are read by the app to initialize the Supabase client.

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
REACT_APP_SUPABASE_URL=

# Your Supabase anon public key
REACT_APP_SUPABASE_KEY=

# Optional: public site URL used for auth email redirects (if applicable in your flows)
# REACT_APP_SITE_URL=
