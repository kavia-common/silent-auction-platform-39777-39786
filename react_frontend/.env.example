# Supabase configuration (required)
# Ask the project orchestrator to set these in the environment.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional: Override Site URL for auth email redirects (defaults to window.location.origin)
REACT_APP_SITE_URL=

# For local development, copy to .env and fill values:
# cp .env.example .env
