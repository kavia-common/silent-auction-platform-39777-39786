# PUBLIC_INTERFACE
# Required environment variables for the React frontend.
# Ensure you copy this file to `.env` and set real values.
# Create React App only exposes variables prefixed with REACT_APP_.

# Supabase project URL (e.g., https://qtnyjidrsqgrkbelcwfp.supabase.co)
REACT_APP_SUPABASE_URL=

# Supabase anon public API key (Settings -> API -> Project API keys -> anon public)
REACT_APP_SUPABASE_KEY=

# Optional: site URL used for auth magic link redirect (defaults to window.location.origin)
REACT_APP_SITE_URL=
