# Environment variables required by the React frontend

# PUBLIC_INTERFACE
# Supabase project URL (e.g., https://your-project.supabase.co)
REACT_APP_SUPABASE_URL=

# PUBLIC_INTERFACE
# Supabase anonymous key (anon/public key)
REACT_APP_SUPABASE_KEY=

# PUBLIC_INTERFACE
# Supabase Storage bucket name for item images. If not set, defaults to 'the auction images'.
# Note: Bucket name is case-sensitive and may include spaces. Use the exact name as in your Supabase dashboard.
REACT_APP_SUPABASE_BUCKET_NAME=the auction images

# Optional: if using magic links and redirects
REACT_APP_SITE_URL=http://localhost:3000
