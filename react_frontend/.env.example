# Copy this file to .env and provide your values

# Supabase project URL (e.g., https://xxxx.supabase.co)
REACT_APP_SUPABASE_URL=

# Supabase anon public key (from your Supabase project's API settings)
REACT_APP_SUPABASE_KEY=

# Optional: override the site URL used for magic link redirects.
# If not set, window.location.origin is used at runtime.
REACT_APP_SITE_URL=
