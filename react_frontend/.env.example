# Environment variables required by the React frontend.
# Copy this file to ".env" at the project root of the react_frontend container and fill in the values.

# Supabase project URL (e.g., https://xyzcompanyabc.supabase.co)
REACT_APP_SUPABASE_URL=

# Supabase anon public API key (Project Settings -> API -> anon public)
REACT_APP_SUPABASE_KEY=
